{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Выберите существующий Prometheus datasource",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "12.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "stat",
      "version": ""
    },
    {
      "type": "panel",
      "id": "state-timeline",
      "name": "state-timeline",
      "version": ""
    }
  ],
  "id": null,
  "uid": "zzap-integration-health",
  "title": "ZZap — входящая синхронизация",
  "description": "Доступность метрик, состояние polling ZZap, worker, ошибки и история состояния.",
  "tags": [
    "zzap",
    "chatwoot",
    "observability"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "15s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "15s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1,
        "current": {
          "selected": false,
          "text": "Prometheus",
          "value": "${DS_PROMETHEUS}"
        },
        "options": [],
        "hide": 0,
        "multi": false,
        "includeAll": false
      },
      {
        "name": "job",
        "label": "Job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "$datasource"
        },
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "query": {
          "query": "label_values(zzap_poll_initialized_timestamp_seconds, job)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(zzap_poll_initialized_timestamp_seconds, job)",
        "current": {
          "selected": false,
          "text": "chatwoot-zzap",
          "value": "chatwoot-zzap"
        },
        "options": []
      },
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "$datasource"
        },
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "query": {
          "query": "label_values(up{job=\"$job\"}, instance)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(up{job=\"$job\"}, instance)",
        "current": {
          "selected": false,
          "text": "zzap.gt-shop.ru:443",
          "value": "zzap.gt-shop.ru:443"
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Метрики доступны",
      "description": "Доступность /metrics для Prometheus. Нет данных — target или Prometheus недоступен.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "Нет данных",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Scrape недоступен",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "Scrape доступен",
                  "color": "green",
                  "index": 1
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Нет данных",
                  "color": "gray"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "expr": "up{job=\"$job\",instance=\"$instance\"}",
          "legendFormat": "Scrape",
          "editorMode": "code",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "last"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "wideLayout": true
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Polling ZZap",
      "description": "Деградация — превышен настроенный порог без успешного чтения списка тредов. До инициализации и при недоступных метриках — Нет данных.",
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "Нет данных",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Нет деградации",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "Деградация",
                  "color": "red",
                  "index": 1
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Нет данных",
                  "color": "gray"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "expr": "(zzap_poll_degraded{job=\"$job\",instance=\"$instance\"}) and on(job, instance) (up{job=\"$job\",instance=\"$instance\"} == 1) and on(job, instance) (zzap_poll_initialized_timestamp_seconds{job=\"$job\",instance=\"$instance\"} > 0)",
          "legendFormat": "Polling",
          "editorMode": "code",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "last"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "wideLayout": true
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Worker",
      "description": "Heartbeat свежий, если обновлялся не более 120 секунд назад. До первого heartbeat и при недоступных метриках — Нет данных.",
      "gridPos": {
        "x": 10,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "Нет данных",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Heartbeat устарел",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "Heartbeat свежий",
                  "color": "green",
                  "index": 1
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Нет данных",
                  "color": "gray"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "expr": "(((time() - zzap_worker_last_heartbeat_timestamp_seconds{job=\"$job\",instance=\"$instance\"}) and on(job, instance) (zzap_worker_last_heartbeat_timestamp_seconds{job=\"$job\",instance=\"$instance\"} > 0)) and on(job, instance) (up{job=\"$job\",instance=\"$instance\"} == 1)) <= bool 120",
          "legendFormat": "Worker",
          "editorMode": "code",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "last"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "wideLayout": true
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Ошибок подряд",
      "description": "Последовательные HTTP и сетевые ошибки polling. Сбрасываются после успешного чтения списка тредов.",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "Нет данных",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Нет данных",
                  "color": "gray"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          },
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "expr": "(zzap_poll_consecutive_failures{job=\"$job\",instance=\"$instance\"}) and on(job, instance) (up{job=\"$job\",instance=\"$instance\"} == 1)",
          "legendFormat": "Ошибки",
          "editorMode": "code",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "last"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "wideLayout": true
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "HTTP ZZap",
      "description": "Последний HTTP-код polling. 0 — нет ответа или истории. HTTP 200 сам по себе не гарантирует корректный ответ ZZap.",
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "Нет данных",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Нет HTTP-ответа / истории",
                  "color": "gray",
                  "index": 0
                },
                "200": {
                  "text": "200 OK",
                  "color": "green",
                  "index": 1
                },
                "401": {
                  "text": "401 Unauthorized",
                  "color": "red",
                  "index": 2
                },
                "403": {
                  "text": "403 Forbidden",
                  "color": "red",
                  "index": 3
                },
                "429": {
                  "text": "429 Too Many Requests",
                  "color": "orange",
                  "index": 4
                },
                "500": {
                  "text": "500 Server Error",
                  "color": "red",
                  "index": 5
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Нет данных",
                  "color": "gray"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "gray",
                "value": null
              },
              {
                "color": "green",
                "value": 200
              },
              {
                "color": "orange",
                "value": 300
              },
              {
                "color": "red",
                "value": 400
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "expr": "(zzap_poll_last_http_status{job=\"$job\",instance=\"$instance\"}) and on(job, instance) (up{job=\"$job\",instance=\"$instance\"} == 1)",
          "legendFormat": "HTTP",
          "editorMode": "code",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "last"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "wideLayout": true
      }
    },
    {
      "id": 14,
      "type": "state-timeline",
      "title": "История состояния",
      "description": "Доступность метрик, деградация polling и свежесть heartbeat. Пропуски данных не соединяются.",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "Нет данных",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Нет данных",
                  "color": "gray"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "custom": {
            "spanNulls": false,
            "insertNulls": false,
            "lineWidth": 0,
            "fillOpacity": 80
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Scrape"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "Scrape недоступен",
                        "color": "red",
                        "index": 0
                      },
                      "1": {
                        "text": "Scrape доступен",
                        "color": "green",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Polling: деградация"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "Нет деградации",
                        "color": "green",
                        "index": 0
                      },
                      "1": {
                        "text": "Деградация",
                        "color": "red",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Worker: heartbeat свежий"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "Heartbeat устарел",
                        "color": "red",
                        "index": 0
                      },
                      "1": {
                        "text": "Heartbeat свежий",
                        "color": "green",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "expr": "up{job=\"$job\",instance=\"$instance\"}",
          "legendFormat": "Scrape",
          "editorMode": "code",
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "expr": "(zzap_poll_degraded{job=\"$job\",instance=\"$instance\"}) and on(job, instance) (up{job=\"$job\",instance=\"$instance\"} == 1) and on(job, instance) (zzap_poll_initialized_timestamp_seconds{job=\"$job\",instance=\"$instance\"} > 0)",
          "legendFormat": "Polling: деградация",
          "editorMode": "code",
          "instant": false,
          "range": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "expr": "(((time() - zzap_worker_last_heartbeat_timestamp_seconds{job=\"$job\",instance=\"$instance\"}) and on(job, instance) (zzap_worker_last_heartbeat_timestamp_seconds{job=\"$job\",instance=\"$instance\"} > 0)) and on(job, instance) (up{job=\"$job\",instance=\"$instance\"} == 1)) <= bool 120",
          "legendFormat": "Worker: heartbeat свежий",
          "editorMode": "code",
          "instant": false,
          "range": true
        }
      ],
      "options": {
        "mergeValues": true,
        "showValue": "auto",
        "alignValue": "center",
        "rowHeight": 0.85,
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    }
  ]
}
